@page "/"
@using Clients.Model
@using Clients.Blazor.Services
@inject ClientsService ClientsService
@inject OrderService OrderService
@inject ProductService ProductServices
@inject FileService FileService
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations;
@inject IJSRuntime JSRuntime

@if (curOrderStage == OrderStage.OrdersList)
{
    if (orders != null)
    {
        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="mb-3">Orders List</h1>
                <h4>Total Orders: @orders.Count</h4>
            </div>

            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (Order curorder in orders)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div>
                                @foreach (Product currProduct in GetProductsHashSet(OrderToProductListDict[curorder.Id]))
                                {
                                    <div class="card mb-3 bg-light position-relative" style="max-width: 540px;">
                                        <div class="row g-0">
                                            <div class="col-md-4">
                                                <img src=@GetPicturePath(currProduct.Picture) class="img-fluid rounded-start" alt="...">
                                            </div>
                                            <div class="col-md-8">
                                                <div class="card-body">
                                                    <h5 class="card-title">@currProduct.Name</h5>
                                                    <p class="card-text">@currProduct.Price₪</p>
                                                    <p class="card-text"><small class="text-muted">@currProduct.Description</small></p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="product-card card p-1 m-0">
                                            @GetProductCount(OrderToProductListDict[curorder.Id], currProduct)
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="card-body">
                                <h4 class="card-title">@curorder.Client.FirstName @curorder.Client.LastName</h4>
                                <h5 class="card-subtitle text-muted">@curorder.Date.ToShortDateString()</h5>
                                <p class="card-text mt-4 mb-1"><strong>City:</strong> @curorder.Client.City</p>
                                <p class="card-text mt-0"><strong>Note:</strong> @curorder.Note</p>
                            </div>
                            <div class="card-footer d-flex justify-content-between">
                                <button @onclick="() => EditOrder(curorder)" class="btn btn-outline-primary btn-warning">✏️ Edit</button>
                                <button data-bs-toggle="modal" data-bs-target="#deleteModal" class="btn btn-outline-primary btn-danger" @onclick="() => ConfirmDeleteOrder(curorder)">🗑 Delete</button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3 pt-5">
                <button class="btn btn-primary" @onclick="() => SetCurStage(OrderStage.OrderDetails)">Next ⏩</button>
            </div>
        </div>
    }
}

<EditForm Model="editOrder" OnInvalidSubmit="Save" class="container mt-4">
    <DataAnnotationsValidator />

    @if (curOrderStage == OrderStage.OrderDetails)
    {
        <div class="card p-4">
            <h4>@(IsNewOrder ? "New Order" : "Edit Order")</h4>

            <div class="mb-3">
                <label for="orderDate" class="form-label"><b>Date:</b></label>
                <InputDate id="orderDate" @bind-Value="editOrder.Date" class="form-control"></InputDate>
            </div>

            <div class="mb-3">
                <label for="orderNote" class="form-label"><b>Note:</b></label>
                <InputText id="orderNote" @bind-Value="editOrder.Note" class="form-control"></InputText>
            </div>

            <div class="mb-3">
                <label for="clientSelect" class="form-label"><b>Client:</b></label>
                @if (clients != null)
                {
                    <InputSelect id="clientSelect" @bind-Value="selectedClientId" class="form-select">
                        <option value="-1">Select a client</option>
                        @foreach (var client in clients)
                        {
                            <option value="@client.Id">@client.FirstName</option>
                        }
                    </InputSelect>
                }
            </div>

            <div class="d-flex justify-content-between">
                <button type="button" @onclick="ClearForm" class="btn btn-warning">Clear Form 🗑️</button>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-secondary me-2" @onclick="() => SetCurStage(OrderStage.OrdersList)">⏪ Prev</button>
                    <button class="btn btn-primary" @onclick="() => SetCurStage(OrderStage.Products)">Next ⏩</button>
                </div>
            </div>
        </div>
    }

    @if (curOrderStage == OrderStage.Products)
    {
        if (products != null)
        {
            <div class="container mt-4">
                <h1>Product List</h1>
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @foreach (Product curProduct in products)
                    {
                        OrderProduct curOrderProduct = FindFromProduct(curProduct);

                        <div class="col">
                            <div class="card h-100 position-relative">
                                <img src=@GetPicturePath(curProduct.Picture) class="card-img-top" alt="Product Image">
                                <div class="card-body">
                                    <h5 class="card-title">@curProduct.Name</h5>
                                    <p class="card-text"><strong>Company:</strong> @curProduct.Company.Name</p>
                                    <p class="card-text">@curProduct.Description</p>
                                    <p class="card-text"><strong>Price:</strong> @curProduct.Price</p>
                                    <p class="card-text"><strong>In Stock:</strong> @curProduct.Count</p>

                                    <div class="d-flex justify-content-around">
                                        <button class="btn btn-primary product-button-width" @onclick="() => AddProductToOrder(curProduct)">
                                            @(IsInBasket(curProduct) ? "Add ➕" : "Add To Order")
                                        </button>
                                        @if (IsInBasket(curProduct))
                                        {
                                            <button class="btn btn-danger product-button-width" @onclick="() => RemoveProductFromOrder(curProduct)">Remove ❌</button>
                                        }
                                    </div>
                                    @if (IsInBasket(curProduct)) 
                                    {
                                        <div class="product-quantity card bg-gradient p-1 m-0">@curOrderProduct.Quantity Added</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-3 pt-5">
                    <button class="btn btn-secondary" @onclick="() => SetCurStage(OrderStage.OrderDetails)">⏪ Prev</button>
                    <button type="submit" @onclick="Save" class="btn btn-success ms-2">Save 💾</button>
                </div>
            </div>
        }
    }
</EditForm>

@if (isShowPageMessage)
{
    <div class="confirmation-dialog position-fixed top-50 start-50 translate-middle bg-white p-4 border rounded shadow-lg d-flex flex-column gap-4">
        <h5 class="confirmation-text fw-bold">@pageMessage</h5>
        <div class="button-group d-flex justify-content-center">
            <button class="btn btn-primary" @onclick="ClearMessage">Close</button>
        </div>
    </div>
}

@if (showConfirmDelete)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal">
            <div class="modal-header">
                <h5>Confirm Deletion</h5>
                <button class="btn-close" @onclick="CancelDeleteOrder">×</button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this order?
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CancelDeleteOrder">No</button>
                <button class="btn btn-danger" @onclick="DeleteOrder">Yes</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Product>? productsInBasket = new List<Product>();
    private List<Order>? orders;
    private List<Product>? products;
    private Dictionary<int, List<Product>?> OrderToProductListDict = new();
    private List<OrderProduct>? orderProducts = new List<OrderProduct>();
    private List<Client>? clients;

    private bool IsNewOrder => editOrder.Id < 1;
    private OrderStage curOrderStage = OrderStage.OrdersList;
    private enum OrderStage { OrdersList, OrderDetails, Products }
    private void SetCurStage(OrderStage to) { curOrderStage = to; }

    private bool showConfirmDelete = false;
    private bool isShowPageMessage = false;
    private string pageMessage = "";

    private Order editOrder = new Order();
    private Order orderToDelete = new Order();
    int selectedClientId;
    private List<string> moreValidations = new List<string>();

    public string CurFolder4Display => $"{FileService.Folder4Display}/Products";
    public string UploadedImagesPath = "uploads";
    public string GetPicturePath(string fileName) => UploadedImagesPath + "/" + fileName;

    protected override async Task OnInitializedAsync()
    {
        await SetDefaults();
        products = await ProductServices.Read();
        selectedClientId = -1;
    }

    private void ClearForm()
    {
        editOrder = new Order { Date = DateTime.Today };
        selectedClientId = -1;
    }

    private void ClearMessage()
    {
        isShowPageMessage = false;
        pageMessage = "";
    }

    protected async Task SetDefaults()
    {
        orders = await OrderService.Read();
        clients = await ClientsService.Read();
        moreValidations = new List<string>();

        foreach (Order currOrder in orders)
        {
            if (!OrderToProductListDict.ContainsKey(currOrder.Id))
            {
                OrderToProductListDict.Add(currOrder.Id, await GetProductsFromOrder(currOrder.Id));
            }
        }
    }

    private OrderProduct FindFromProduct(Product curProduct)
    {
        return orderProducts.FirstOrDefault(orderProduct => orderProduct.Product.Id == curProduct.Id);
    }

    private async Task<List<Product>> GetProductsFromOrder(int OrderId)
    {
        orderProducts = await OrderService.ReadOrderProducts(OrderId);

        productsInBasket = orderProducts.Select(op => op.Product).ToList();

        return productsInBasket;
    }

    private List<Product> GetProductsHashSet(List<Product> productList)
    {
        HashSet<Product> set = new HashSet<Product>(productList);
        return set.ToList();
    }

    private string GetProductCount(List<Product> productList, Product prod)
    {
        int count = productList.FindAll((currProd) => currProd.Id == prod.Id).Count;
        return $"x{count}";
    }

    private async Task<int> GetOrderPrice(int OrderId)
    {
        orderProducts = await OrderService.ReadOrderProducts(OrderId);

        return orderProducts.Sum(orderProduct => orderProduct.Price);
    }


    private async void Save()
    {
        moreValidations = new List<string>();
        if (selectedClientId < 1) moreValidations.Add("Client is required");
        if (moreValidations.Count > 0)
        {
            await InvokeAsync(StateHasChanged);
            isShowPageMessage = true;
            pageMessage = moreValidations.First();
            return;
        }
        editOrder.Client = clients.FirstOrDefault(client => client.Id == selectedClientId);

        bool success = editOrder.Id == 0 ? await OrderService.Create(editOrder, orderProducts) : await OrderService.Update(editOrder, orderProducts);
        isShowPageMessage = true;
        pageMessage = success ? (editOrder.Id == 0 ? "✅ Order was Created" : "Order was Updated 🔄") : (editOrder.Id == 0 ? "Error Creating Order" : "Error Updating Order");

        await SetDefaults();
        ClearForm();
        await InvokeAsync(StateHasChanged);
    }

    private void ConfirmDeleteOrder(Order curOrder)
    {
        orderToDelete = curOrder;
        showConfirmDelete = true;
        InvokeAsync(() => JSRuntime.InvokeVoidAsync("openDeleteModal"));
    }

    private void CancelDeleteOrder()
    {
        orderToDelete = new Order();
        showConfirmDelete = false;
        InvokeAsync(() => JSRuntime.InvokeVoidAsync("closeDeleteModal"));
    }

    private async void DeleteOrder()
    {
        bool success = await OrderService.Delete(orderToDelete.Id);
        isShowPageMessage = true;
        pageMessage = success ? "Order was Deleted" : "Error Deleting Order";

        await InvokeAsync(() => JSRuntime.InvokeVoidAsync("closeDeleteModal"));

        orderToDelete = new Order();
        showConfirmDelete = false;
        await SetDefaults();
        await InvokeAsync(StateHasChanged);
    }

    private async void EditOrder(Order curOrder)
    {
        editOrder = new Order(curOrder.Id, curOrder.Date, curOrder.Client, curOrder.Note);
        selectedClientId = editOrder.Client.Id;
        orderProducts = await OrderService.ReadOrderProducts(editOrder);

        productsInBasket = orderProducts.Select(op => op.Product).ToList();
        curOrderStage = OrderStage.OrderDetails;
        await InvokeAsync(StateHasChanged);
    }

    public bool IsInBasket(Product curProduct)
    {
        return productsInBasket.Any(item => item.Id == curProduct.Id);
    }

    private void UpdateOrderProduct(Product curProduct, int toAdd)
    {
        var curOrderProduct = orderProducts.FirstOrDefault(op => op.Product.Id == curProduct.Id);
        if (curOrderProduct != null)
        {
            curOrderProduct.Quantity += toAdd;
            if (curOrderProduct.Quantity == 0)
            {
                productsInBasket.Remove(curProduct);
                orderProducts.Remove(curOrderProduct);
            }
        }
    }

    private void AddProductToOrder(Product curProduct)
    {
        if (!IsInBasket(curProduct))
        {
            productsInBasket.Add(curProduct);
            orderProducts.Add(new OrderProduct(editOrder, curProduct, curProduct.Price, 1));
        }
        else
        {
            UpdateOrderProduct(curProduct, 1);
        }
        UpdateProductsCount(curProduct, -1);
    }

    private void RemoveProductFromOrder(Product curProduct)
    {
        UpdateOrderProduct(curProduct, -1);
        UpdateProductsCount(curProduct, 1);
    }

    private void UpdateProductsCount(Product curProduct, int toAdd)
    {
        var product = products.FirstOrDefault(p => p.Id == curProduct.Id);
        if (product != null)
        {
            product.Count += toAdd;
        }
    }
}