@page "/List"
@using Model
@using Clients.Blazor.Services
@using System.ComponentModel.DataAnnotations
@inject ClientsService ClientsService
@inject CityService CityService
@rendermode InteractiveServer

@if (clients != null)
{
    <div class="container mt-4">
        <div class="header text-center mb-4">
            <h1>Client Management</h1>
        </div>

        <!-- Filters -->
        <div class="filter-container mb-4 p-3 border rounded shadow-sm">
            <h5>Filter Clients:</h5>
            <div class="row">
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="First Name..." @bind="filterFirstName" @oninput="SetFirstName" @onkeyup="Filter" />
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="Last Name..." @bind="filterLastName" @oninput="SetLastName" @onkeyup="Filter" />
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="Gender..." @bind="filterGender" @oninput="SetGender" @onkeyup="Filter" />
                </div>
                <div class="col-md-3">
                    <input type="number" class="form-control" placeholder="Age..." value="@filterAge.ToString()" @oninput="SetAge" @onkeyup="Filter" />
                </div>
            </div>
            <div class="mt-3">
                <span class="btn btn-secondary btn-sm" @onclick="ClearFilter">Reset Filters 🗑</span>
            </div>
        </div>

        <!-- Clients List -->
        <div class="clients-list mb-4">
            <h3>Client List</h3>
            <ul class="list-group">
                @foreach (var curclient in filteredclients)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@curclient.FirstName @curclient.LastName</strong><br />
                            <small>Age: @curclient.Age | Gender: @curclient.Gender</small><br />
                            <small>Email: @curclient.Email | City: @curclient.City.Name</small>
                        </div>
                        <div>
                            <button @onclick="() => EditClient(curclient)" class="btn btn-warning btn-sm me-2">Edit</button>
                            <button @onclick="() => ConfirmDelete(curclient)" class="btn btn-danger btn-sm">Delete</button>
                        </div>
                    </li>
                }
            </ul>
            <h6 class="mt-3">Total Clients: @filteredclients.Count</h6>
            <h6>Total Cities: @cities.Count</h6>
        </div>

        <!-- Edit Client Form -->
        <div class="edit-form mb-4 p-3 border rounded shadow-sm">
            <h3>@btnText Client</h3>
            <EditForm Model="editClient" OnValidSubmit="SaveClient">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label for="firstName" class="form-label">First Name</label>
                    <InputText @bind-Value="editClient.FirstName" class="@GetFieldClass("FirstName")" id="firstName" />
                </div>
                <div class="mb-3">
                    <label for="lastName" class="form-label">Last Name</label>
                    <InputText @bind-Value="editClient.LastName" class="@GetFieldClass("LastName")" id="lastName" />
                </div>
                <div class="mb-3">
                    <label for="birthYear" class="form-label">Birth Year</label>
                    <InputNumber @bind-Value="editClient.BirthYear" class="@GetFieldClass("BirthYear")" id="birthYear" />
                </div>
                <div class="mb-3">
                    <label for="gender" class="form-label">Gender</label>
                    <InputText @bind-Value="editClient.Gender" class="@GetFieldClass("Gender")" id="gender" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <InputText @bind-Value="editClient.Email" class="@GetFieldClass("Email")" id="email" />
                </div>
                <div class="mb-3">
                    <label for="city" class="form-label">City</label>
                    <InputSelect @bind-Value="selectedCityId" class="@GetFieldClass("City")" id="city">
                        <option value="-1" disabled selected>Select a city</option>
                        @foreach (var city in cities)
                        {
                            <option value="@city.Id">@city.Name</option>
                        }
                    </InputSelect>
                </div>
                <button type="submit" class="btn btn-primary">@btnText</button>
            </EditForm>
        </div>

        <!-- Confirmation Dialogs -->
        @if (showConfirmDelete)
        {
            <div class="confirmation-dialog position-fixed top-50 start-50 translate-middle bg-white p-4 border rounded shadow-lg">
                <h5 class="confirmation-text">Are you sure you want to delete this client?</h5>
                <div class="button-group d-flex justify-content-end align-items-center">
                    <button class="btn btn-secondary me-1" @onclick="CancelDelete">No</button>
                    <button class="btn btn-danger" @onclick="DeleteClient">Yes</button>
                </div>
            </div>
        }

        @if (isShowPageMessage)
        {
            <div class="confirmation-dialog position-fixed top-50 start-50 translate-middle bg-white p-4 border rounded shadow-lg d-flex flex-column gap-4">
                <h5 class="confirmation-text fw-bold">@pageMessage</h5>
                <div class="button-group d-flex justify-content-center">
                    <button class="btn btn-primary" @onclick="ClearMessage">Close</button>
                </div>
            </div>
        }

        @if (showModal)
        {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content border-danger">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">Missing Fields</h5>
                            <button type="button" class="btn-close" @onclick="() => showModal = false"></button>
                        </div>
                        <div class="modal-body">
                            <p>Please fill in the following fields:</p>
                            <ul>
                                @foreach (var field in missingFields)
                                {
                                    <li>@field</li>
                                }
                            </ul>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="() => showModal = false">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Client> clients, filteredclients;
    private List<City> cities;
    private Client editClient = new();
    private City editCity = new();
    private Client clientToDelete = new();
    private City CityToDelete = new();

    private string filterFirstName = "", filterLastName = "", filterGender = "";
    private int filterAge = 0, selectedCityId = -1;
    private bool showConfirmDelete = false, isShowPageMessage = false;
    private string pageMessage = "", btnText = "Add";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        clients = await ClientsService.Read();
        filteredclients = clients;
        cities = await CityService.Read();
    }

    private void ClearMessage() => (isShowPageMessage, pageMessage) = (false, "");

    private void EditClient(Client curClient)
    {
        editClient = new(curClient.Id, curClient.FirstName, curClient.LastName, curClient.BirthYear, curClient.Gender, curClient.Email, curClient.City);
        selectedCityId = editClient.City.Id;
        btnText = "Update";
    }

    private void ConfirmDelete(Client curClient) => (clientToDelete, showConfirmDelete) = (curClient, true);

    private void CancelDelete() => (clientToDelete, showConfirmDelete) = (new(), false);

    private async Task DeleteClient()
    {
        if (await ClientsService.Delete(clientToDelete.Id))
        {
            isShowPageMessage = true;
            pageMessage = "Client was deleted";
            await LoadData();
        }
        showConfirmDelete = false;
    }

    private async Task SaveClient()
    {
        ValidateFields();

        editClient.City = cities.Find((curCity) => curCity.Id == selectedCityId);

        if (missingFields.Any())
        {
            showModal = true;
            return;
        }

        if (btnText == "Add")
        {
            if (await ClientsService.Create(editClient))
            {
                isShowPageMessage = true;
                pageMessage = "Client was added";
                await LoadData();
            }
        }
        else
        {
            if (await ClientsService.Update(editClient))
            {
                isShowPageMessage = true;
                pageMessage = "Client was updated";
                btnText = "Add";
                await LoadData();
            }
        }

        editClient = new();
        selectedCityId = -1;
        fieldErrors.Clear();
    }

    //Save Client Check
    private List<string> missingFields = new();
    private Dictionary<string, bool> fieldErrors = new();
    private bool showModal = false;

    private void ValidateFields()
    {
        missingFields.Clear();
        fieldErrors.Clear();

        if (string.IsNullOrWhiteSpace(editClient.FirstName))
        {
            missingFields.Add("First Name");
            fieldErrors["FirstName"] = true;
        }

        if (string.IsNullOrWhiteSpace(editClient.LastName))
        {
            missingFields.Add("Last Name");
            fieldErrors["LastName"] = true;
        }

        if (editClient.BirthYear == 0)
        {
            missingFields.Add("Birth Year");
            fieldErrors["BirthYear"] = true;
        }

        if (string.IsNullOrWhiteSpace(editClient.Gender))
        {
            missingFields.Add("Gender");
            fieldErrors["Gender"] = true;
        }

        if (string.IsNullOrWhiteSpace(editClient.Email))
        {
            missingFields.Add("Email");
            fieldErrors["Email"] = true;
        }

        if (selectedCityId == -1)
        {
            missingFields.Add("City");
            fieldErrors["City"] = true;
        }
    }

    private string GetFieldClass(string field)
    {
        var baseClass = field == "City" ? "form-select" : "form-control";
        return fieldErrors.ContainsKey(field) ? $"{baseClass} is-invalid" : baseClass;
    }
    //End Save Client

    private void ClearFilter()
    {
        filterFirstName = filterLastName = filterGender = "";
        filterAge = 0;
        Filter();
    }

    private void Filter()
    {
        filteredclients = clients
            .Where(c => c.FirstName.Contains(filterFirstName, StringComparison.OrdinalIgnoreCase)
                     && c.LastName.Contains(filterLastName, StringComparison.OrdinalIgnoreCase)
                     && c.Gender.Contains(filterGender, StringComparison.OrdinalIgnoreCase)
                     && (filterAge == 0 || c.Age == filterAge))
            .ToList();
    }

    private async Task SetFirstName(ChangeEventArgs e)
    {
        // Get the current typed value
        filterFirstName = e.Value?.ToString();
    }

    private async Task SetLastName(ChangeEventArgs e)
    {
        // Get the current typed value
        filterLastName = e.Value?.ToString();
    }

    private async Task SetGender(ChangeEventArgs e)
    {
        // Get the current typed value
        filterGender = e.Value?.ToString();
    }

    private async Task SetAge(ChangeEventArgs e)
    {
        // Get the current typed value
        filterAge = int.Parse(e.Value?.ToString());
    }
}
